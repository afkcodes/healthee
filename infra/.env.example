# Healthee infra env — copy to infra/.env and fill in. .env is gitignored.
# Consumed by docker-compose.prod.yml, deploy.sh, and backup/pg_dump_backup.sh.
# Generate tokens: openssl rand -base64 48 | tr -d '/+=' | head -c 32

# ─── Postgres / TimescaleDB ──────────────────────────────────────────────
# POSTGRES_HOST is 'db' for the compose stack (service name on the network).
# POSTGRES_USER/PASSWORD are the OWNER/ADMIN identity: they create the DB, own
# the tables, and run migrations / claim_sentinel / provision_app_role. They are
# NOT what the app connects as — see POSTGRES_APP_* below.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=healthee
POSTGRES_USER=healthee
POSTGRES_PASSWORD=change-me-please

# ─── Postgres application role (least privilege, MULTI_USER.md §3.3) ─────
# The role the api/scheduler pool connects as: DML on the data tables only —
# no TRUNCATE, no DDL, NOSUPERUSER, NOBYPASSRLS. It exists because a SUPERUSER
# bypasses Row-Level Security unconditionally, which would make §3.3's policies
# test green and protect nothing.
#
# These are REQUIRED. Blank ⇒ the app would fall back to the admin creds, and the
# server now REFUSES TO BOOT rather than serve a multi-tenant product with RLS
# isolating nothing (core/config.py). That fallback is a transitional state, not a
# configuration, so it has to be asked for by name — see ALLOW_ADMIN_DB_FALLBACK.
#
# ⚠ DEPLOY ORDER (this is a PROD CREDENTIAL CHANGE — wrong order = outage).
# `infra/deploy.sh` provisions the role itself on every run, but ONLY once both vars
# below are set — which is the same pair the app pool reads. So the bootstrap is
# inherently TWO deploys, and that is the deliberate path:
#   1. deploy with these two blank AND ALLOW_ADMIN_DB_FALLBACK=true — the app falls
#      back to the admin creds and stays alive; the startup log warns that RLS is
#      isolating nothing;
#   2. set BOTH vars here, remove ALLOW_ADMIN_DB_FALLBACK, then deploy again —
#      deploy.sh provisions the role (as the admin) BEFORE recreating the app, so it
#      exists by the time the app needs it;
#   3. confirm the startup log says "connected as least-privilege role".
# Setting these while the role does not yet exist means the app cannot authenticate to
# Postgres at all. Full procedure + the why: infra/DEPLOY.md "The credential ORDER".
# Generate: openssl rand -base64 48 | tr -d '/+=' | head -c 32
POSTGRES_APP_USER=healthee_app
POSTGRES_APP_PASSWORD=change-me-please

# The transitional opt-out for step 1 above, and NOTHING else. `true` here says "this
# deployment knowingly runs on a role that bypasses Row-Level Security". Leave it out
# (or false) once the role exists. It is a var rather than a blank field because the
# absence of a value looks identical to never having considered the question, and this
# is a question a multi-tenant deployment has to have answered.
ALLOW_ADMIN_DB_FALLBACK=false

# ─── FastAPI bind (inside the container) ─────────────────────────────────
# ⚠ This is the bind address INSIDE the container, not your domain. The public
# name is PUBLIC_HOST below — two different questions that both sound like
# "the host", which is why they are not called the same thing.
API_HOST=0.0.0.0
API_PORT=8765

# ─── The public name this deployment answers on ──────────────────────────
# A bare hostname: no scheme, no port, no path.
#
# Set it once here and every deployment-specific place reads it instead of being
# edited: `infra/nginx/render-vhost.sh` substitutes it into the vhost's
# `server_name`, certbot takes it as `-d`, and DEPLOY.md's smoke checks are
# copy-pasteable without retyping anything. Nothing tracked in this repository
# names a real host, so a clone or a fork carries nobody's server but its own.
#
# The MOBILE build reads its own copy from `apps/mobile/build.env` (HELIO_API,
# also gitignored) — the app is built on a laptop and deployed from a box, and
# one file cannot be on both.
PUBLIC_HOST=healtheeapi.example.com

# ─── Logging ─────────────────────────────────────────────────────────────
# Python level name: DEBUG | INFO | WARNING | ERROR.
LOG_LEVEL=INFO

# ─── Supabase identity (MULTI_USER.md §4) ────────────────────────────────
# The API only VERIFIES the access JWT Supabase issues; it never mints one.
# Blank secret ⇒ every JWT is refused (fails closed).
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
# Blank project ref ⇒ the `iss` check is skipped (dev / self-signed tokens).
SUPABASE_PROJECT_REF=
SUPABASE_JWT_AUD=authenticated
# The identity provider this deployment tells its APP to sign in against, served
# unauthenticated by GET /api/auth-config — a client needs it BEFORE it can
# authenticate. Both are public by construction: the URL names a project and the
# ANON key is the one Supabase documents as shipping inside clients (it authorises
# nothing on its own; every row policy still applies). ⛔ NEVER the service-role
# key, which bypasses every policy and belongs in SUPABASE_SERVICE_ROLE_KEY.
#
# SUPABASE_URL is optional: blank derives https://<SUPABASE_PROJECT_REF>.supabase.co,
# which is right for hosted Supabase. Set it only for a self-hosted GoTrue.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ─── Signup gating (MULTI_USER.md §4, §13 [D1]) ──────────────────────────
# Enforced by the SERVER (§12.7), gating the creation of NEW accounts only —
# an owner who already has a row always gets in. Uncontrolled signup is
# uncontrolled LLM spend (every active owner gets a nightly chain).
#   SIGNUPS_OPEN=false + empty allowlist ⇒ nobody new (the default).
# Comma-separated, case-insensitive. To onboard the owner: put their email
# here, have them sign in once, then run db.claim_sentinel (§8).
SIGNUPS_OPEN=false
SIGNUP_ALLOWLIST=

# ─── MCP server (docs/MCP.md) ────────────────────────────────────────────
# Read-only endpoint at /mcp for AI tools (Claude Code, Codex), authenticated by a
# device token the owner mints. false = the mount is absent and /mcp is a 404.
MCP_ENABLED=true

# ─── Entitlement (MULTI_USER.md §12, Phase 6.6a) ─────────────────────────
# The AI layer is premium; the tracker is free. Entitlement lives in the
# `subscription` table and is granted with `python -m healthee.db.grant_premium`
# — NOT here. This flag is the one deployment-wide override: set it true only
# on a SELF-HOSTED box, where the LLM bill is the operator's own. On the hosted
# service it must stay false, and the API/scheduler log a warning on every boot
# if it is not. It must reach the SCHEDULER too, or a self-hosted install's
# nightly chain skips the AI steps it just paid for.
SELF_HOST_UNLOCKED=false
# Coach questions a PREMIUM owner gets per rolling 30 days. 20 is the hosted
# service's measured number ($0.179 a question against a $6.99 price — PRICING.md
# §1). **0 means unlimited**, which is the honest setting on a box whose owner pays
# their own OpenRouter bill: the cap's justification is our LLM spend, not theirs.
# This is the DEFAULT. One owner's own cap overrides it in either direction, e.g.
# guests at 20 on a server whose operator is unlimited:
#   python -m healthee.db.grant_premium <uuid> --coach-questions unlimited --apply
PREMIUM_COACH_QUESTIONS=20
# Where a locked card sends someone. Blank until [D4] picks a provider; the
# 402 body and /api/entitlement carry it verbatim.
UPGRADE_URL=

# ─── OpenRouter (optional — grounded LLM insights) ───────────────────────
# The key AND the model ids are kept OUT of git — set the real ids here.
# REQUIRED whenever OPENROUTER_API_KEY is set: a blank model id is sent to the
# API verbatim and comes back a 400. default_model = the cheap high-volume tier
# (recs/briefing/notable/insight cards); coach_model = the stronger interactive
# tier. Compare candidates with `scripts/model_eval.py <model-a> <model-b>`.
# ⚠ The api and scheduler REFUSE TO START with the key set and either id blank —
# that combination is a dead AI layer behind a green /healthz, which is what
# prod actually ran. Leave ALL THREE blank to deploy without the AI layer.
OPENROUTER_API_KEY=
DEFAULT_MODEL=<provider>/<cheap-model-id>
COACH_MODEL=<provider>/<stronger-model-id>
# How the coach spends THINKING: on | off | answer_only. Reasoning is decode-time
# output (measured 2.7–3.7k tokens per question); two of three coach rounds only
# pick a tool. answer_only keeps it for the round that writes the answer.
COACH_REASONING=on
# Bound on ONE LLM call (seconds) and how many times the SDK retries it. Do not
# leave these blank-by-omission: unset, the openai SDK uses a 600 s read timeout
# and 2 retries = 30 minutes of hang for a single stuck call, and the scheduler is
# a single-threaded tick loop — that one call blocks every later owner's chain.
# Worst case here is LLM_MAX_RETRIES+1 × LLM_TIMEOUT_S. Raise the timeout only if
# you switch DEFAULT_MODEL to a slow reasoning tier.
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=1
# The WALL-CLOCK cap on ONE completion, streamed or not — different from the read
# timeout above, which only fires when the socket goes silent. OpenRouter's keepalive
# bytes during a long generation mean it often never is (measured: 594 s across 3
# calls under a supposed 60 s cap). See core/config.py.
LLM_DEADLINE_S=120
# How long ONE grounded run may spend GATHERING (running tools) before it must
# answer with what it already has. Rounds alone did not bound this: at ~100 s a
# round the coach's 20-round ceiling was half an hour against an app that waits
# 360 s, and no coach request ever completed. Hitting it is not an abort —
# gathering stops and the next turn answers, saying what it is short of.
# 360 (the app's wait) minus ~200 for the answer attempts leaves 160; 150 has room.
GATHERING_DEADLINE_S=150
# Dollars remaining on the OpenRouter account below which the scheduler WARNS to
# Telegram (once, on the way in and out — jobs/llm_watch.py). It is only a warning:
# nothing declines to spend because of it. Prod once hit its account ceiling and
# every LLM call 402'd for hours behind a green /healthz; this is the alert that
# fires BEFORE that, and `GET /readyz` is the pull surface for the same facts.
# Set it to a few days of YOUR spend. 0 disables the warning and leaves only the
# "exhausted" alert, which fires when it is already too late.
LLM_LOW_BALANCE_USD=20
# How many NUDGED REWRITES one generated answer gets before the honest fallback
# ships. Only a candidate that ALREADY failed its gates spends one, and the budget
# is reserved on top of the coach's tool-gathering allowance, never taken from it.
# 2 (three attempts) because the failures a nudge repairs are citation/format
# wording — turn it down if you point DEFAULT_MODEL/COACH_MODEL at an expensive
# tier. 0 means one attempt then the fallback; no value lets unvalidated text ship.
LLM_VALIDATION_RETRIES=2
# Ordered OpenRouter provider tags the COACH tier prefers. Empty = OpenRouter's own
# routing, unchanged. Tags come from /api/v1/models/<id>/endpoints and name a provider
# AND its quantization, because a provider serves one model at one precision.
#
# Fallbacks stay ON and are not configurable: this is a preference, not a restriction.
# Verified live 2026-09-09 — `baidu/fp8` was returning 429 rpm_rate_limit_exceeded from
# the upstream shared pool and the request was answered by `wafer/fast`. With fallbacks
# off that would have been a failed question instead.
#
# COACH TIER ONLY (enforced in insights/client). These tags serve the coach model; the
# default tier is a different model most of them do not host, so a blanket order would
# take the nightly chain down.
#
# ⛔ EMPTY, and the default here used to be `baidu/fp8,wafer/fast,coreweave/fp8` while
# production ran with nothing set. A template that disagrees with the deployment it is
# the template FOR is worse than no template: the next person to copy it would have
# turned on a preference nobody was running, and would have found out through latency
# rather than through an error. Pinning is an operator decision, made deliberately and
# measured — not one inherited by copying a file.
LLM_PROVIDER_ORDER=
# What the coach tier sorts providers by when no order is set: throughput (default)
# | latency | price | empty = OpenRouter default (price-weighted, measured slow).
LLM_PROVIDER_SORT=throughput

# ─── Basemap + elevation caches (core/map_tiles.py, derive/dem.py) ───────
# Both are caches of PUBLIC geodata — squares of the world this server fetched,
# never an owner's coordinates. They live on the `healthee-geocache` volume in
# docker-compose.prod.yml; before that volume existed the elevation cache sat
# under /tmp and was re-downloaded after every container restart.
SRTM_CACHE_DIR=/var/cache/healthee/srtm
MAP_TILE_CACHE_DIR=/var/cache/healthee/tiles
# Megabytes the basemap cache may hold before the oldest tiles are evicted.
MAP_TILE_CACHE_MB=512

# ─── Local embedding model cache (insights/embedding_index.py, Step 2a) ──────
# The QUERY-time ONNX model only (69 MB) — cached on the same `healthee-geocache`
# volume as the caches above so a restart doesn't re-download it. The knowledge-corpus
# PASSAGE matrix is a separate, committed artifact (packages/knowledge/embeddings/,
# built on a dev machine) — this box never embeds the corpus itself.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_CACHE_DIR=/var/cache/healthee/embeddings

# ─── Coach evidence passage budget (insights/evidence.py, Step 2b) ────────
# Trims ONLY the coach's own evidence block — every other grounded surface still
# embeds its top-N notes whole. Approx tokens = chars / 4.
EVIDENCE_TOKEN_BUDGET=8000
# The cross-encoder rerank stage, cached on the same volume as the embedding
# model above. false skips it; a model that fails to load degrades the same way
# on its own (logged once), so this is the explicit, no-load opt-out.
# ⚠ Measured on this box's own hardware class (4 CPUs, single-threaded ONNX):
# ~3.5s mean / ~5.1s p95 PER QUESTION (up to 6 notes x 10 reranked candidates),
# +104 MB RSS once loaded — the wall-clock cost is ~10x the ~300ms this deployment
# can spend and the app's coach timeout has little room to give it. Defaulted OFF
# here for that reason; the code default is `true` (see Settings.evidence_rerank)
# for a box with CPU to spare. Flip it on only after re-measuring on THIS box.
EVIDENCE_RERANK=false

# ─── Basemap provider ────────────────────────────────────────────────────
# The phone NEVER talks to a tile provider: it asks this server, which fetches
# and caches. That is what keeps the area the owner exercises in off a third
# party's logs, and it is the shape OpenStreetMap's usage policy sanctions —
# one cached server sending a real User-Agent, not an app pointed at theirs.
#
# Repoint the template at a commercial provider or your own rendering stack and
# the app follows with no new build. It must be http(s) and carry {z} {x} {y}.
# ⚠ CHANGE THE ATTRIBUTION WITH IT — it is served by GET /api/map and drawn on
# screen, and the app cannot tell that a repointed url needs a different credit.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors
# The zoom range served. Outside it a request is refused here, never forwarded.
MAP_TILE_MIN_ZOOM=1
MAP_TILE_MAX_ZOOM=17

# ─── Telegram notifications (optional) ───────────────────────────────────
# Job results + failures are reported here when set.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Deployment (deploy.sh) ──────────────────────────────────────────────
# Branch the VPS deploys from; deploy.sh aborts if local != origin/<branch>.
DEPLOY_BRANCH=main

# ─── Backups (backup/pg_dump_backup.sh) ──────────────────────────────────
# Where dated .sql.gz dumps are written, and how many days to keep.
BACKUP_DIR=/var/backups/healthee
BACKUP_RETENTION_DAYS=30
# Optional off-box copy: a command run with the dump path as $1 (scp/rclone).
# Example: OFFBOX_CMD="rclone copy {} remote:healthee-backups"
# The literal {} is replaced with the dump file path. Leave blank to skip.
OFFBOX_CMD=
