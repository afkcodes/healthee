# Healthee server — environment template. Copy to `.env` and fill in.
# `.env` is git-ignored; NEVER commit real secrets or the model choice.

# ── Postgres / TimescaleDB ──────────────────────────────────────────────
# The OWNER/ADMIN identity: owns the tables and runs migrations, claim_sentinel,
# provision_app_role, and the test reset (TRUNCATE). NOT what the app connects as.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=healthee
POSTGRES_USER=healthee
POSTGRES_PASSWORD=change-me

# ── Postgres application role (least privilege, MULTI_USER.md §3.3) ─────
# The role the request/job pool connects as: DML on the data tables only — no
# TRUNCATE, no DDL, NOSUPERUSER, NOBYPASSRLS (a superuser bypasses Row-Level
# Security, which would make §3.3's policies theatre).
# Blank ⇒ the app would fall back to the admin creds, and the server REFUSES TO BOOT
# on that unless ALLOW_ADMIN_DB_FALLBACK=true asks for it (core/config.py). Both or
# neither: half-set is a hard config error.
# Create it first, as the admin:
#   POSTGRES_APP_USER=healthee_app POSTGRES_APP_PASSWORD='<secret>' \
#     uv run python -m healthee.db.provision_app_role
POSTGRES_APP_USER=healthee_app
POSTGRES_APP_PASSWORD=change-me

# A single-developer box with no least-privilege role yet is the one honest use of
# this. The integration suite does NOT need it in the environment — `tests/conftest.py`
# provisions a throwaway role per run and sets POSTGRES_APP_* itself.
# ALLOW_ADMIN_DB_FALLBACK=false

# ── FastAPI bind ────────────────────────────────────────────────────────
# Container-shaped defaults; local dev normally passes --host/--port to uvicorn
# instead. Listed (commented) so this template stays a complete inventory of what
# `Settings` reads — tests/test_env_templates.py enforces that.
# API_HOST=0.0.0.0
# API_PORT=8765

# ── Logging ─────────────────────────────────────────────────────────────
# Python level name: DEBUG | INFO | WARNING | ERROR.
LOG_LEVEL=INFO

# ── Supabase auth (Phase 6 identity — the API verifies JWTs, never issues) ─
# HS256 legacy shared secret Supabase signs the access token with. Verify only.
SUPABASE_JWT_SECRET=change-me
# Service-role key — later admin/webhook work (delete-user cascade). Keep secret.
SUPABASE_SERVICE_ROLE_KEY=change-me
# Project ref → expected issuer https://<ref>.supabase.co/auth/v1. Blank skips iss.
SUPABASE_PROJECT_REF=<your-ref>
# Expected audience claim (Supabase default).
SUPABASE_JWT_AUD=authenticated
# The identity provider this deployment tells its APP to sign in against, served
# unauthenticated by GET /api/auth-config — a client needs it BEFORE it can
# authenticate. Both are public by construction: the URL names a project and the
# ANON key is the one Supabase documents as shipping inside clients (it authorises
# nothing on its own; every row policy still applies). ⛔ NEVER the service-role
# key, which bypasses every policy and belongs in SUPABASE_SERVICE_ROLE_KEY.
#
# SUPABASE_URL is optional: blank derives https://<SUPABASE_PROJECT_REF>.supabase.co,
# which is right for hosted Supabase. Set it only for a self-hosted GoTrue.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ── Signup gating (MULTI_USER.md §4, §13 [D1]) ──────────────────────────
# Enforced by the SERVER (§12.7), NOT by a Supabase dashboard toggle, and it
# gates the creation of NEW accounts only — an owner who already has a row
# always gets in. Uncontrolled signup is uncontrolled LLM spend: every active
# owner gets a nightly chain (PRICING.md §6).
#   SIGNUPS_OPEN=false + empty allowlist ⇒ nobody new (the default).
# Comma-separated, case-insensitive. To onboard the owner: put their email
# here, have them sign in once, then run db.claim_sentinel (§8).
SIGNUPS_OPEN=false
SIGNUP_ALLOWLIST=

# ── MCP server (docs/MCP.md)───────────────────────────────────────────
# Read-only endpoint at /mcp for AI tools (Claude Code, Codex), authenticated by a
# device token the owner mints. false = the mount is absent and /mcp is a 404.
MCP_ENABLED=true

# ── Entitlement (MULTI_USER.md §12) ─────────────────────────────────────
# Premium comes from the `subscription` table (db.grant_premium), never from
# here. SELF_HOST_UNLOCKED entitles EVERY owner on this deployment — for a
# self-hosted box paying its own LLM bill. False everywhere else.
# SELF_HOST_UNLOCKED=false
# Coach questions a premium owner gets per rolling 30 days. 0 means unlimited.
PREMIUM_COACH_QUESTIONS=20
# UPGRADE_URL=

# ── OpenRouter (grounded LLM) ───────────────────────────────────────────
# The key AND the model ids we run are kept out of git. Set the real model ids
# in this .env (dev) and in the deploy env (prod). default_model = the cheap
# high-volume tier; coach_model = the stronger tier for the interactive coach.
# ⚠ The app REFUSES TO START with the key set and either id blank — it is a dead
# AI layer behind a green /healthz. Blank all three to run without the AI layer.
OPENROUTER_API_KEY=sk-or-...
DEFAULT_MODEL=<provider>/<cheap-model-id>
COACH_MODEL=<provider>/<stronger-model-id>
# Coach thinking per round: on | off | answer_only (see core/config.py).
# COACH_REASONING=on
# ── The eval key — DEV ONLY, never in infra/.env, never on the VPS ──────
# tests/grounding_eval spends real money (~$3/arm) and on 2026-08-01 it emptied
# the shared account, 402'ing every production LLM call for hours behind a green
# /healthz. Give it its own OpenRouter key with a SMALL credit limit, so a drained
# eval costs an eval run and not the live AI layer. Unset is allowed and still
# runs — on the production key, after a loud warning. infra/DEPLOY.md §E2.
# EVAL_OPENROUTER_API_KEY=sk-or-...
# Bound on ONE LLM call (seconds) + SDK retries. Explicit because the SDK's own
# defaults are 600 s × 3 attempts = a 30-minute hang, which in the single-threaded
# scheduler tick costs every later owner their chain. Worst case is
# LLM_MAX_RETRIES+1 × LLM_TIMEOUT_S.
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=1
# The WALL-CLOCK cap on ONE completion, streamed or not — different from the read
# timeout above, which only fires when the socket goes silent. OpenRouter's keepalive
# bytes during a long generation mean it often never is (measured: 594 s under a
# supposed 60 s cap). See core/config.py.
LLM_DEADLINE_S=120
# How long ONE grounded run may spend GATHERING (running tools) before it must
# answer with what it already has. Rounds alone did not bound this: at ~100 s a
# round the coach's 20-round ceiling was half an hour against an app that waits
# 360 s, and no coach request ever completed. Hitting it is not an abort —
# gathering stops and the next turn answers, saying what it is short of.
# 360 (the app's wait) minus ~200 for the answer attempts leaves 160; 150 has room.
GATHERING_DEADLINE_S=150
# Balance below which the scheduler warns to Telegram (jobs/llm_watch.py). Warning
# only — nothing stops spending. See `GET /readyz` for the pull-side view.
# LLM_LOW_BALANCE_USD=20
# Nudged rewrites an answer gets before the honest fallback ships. Reserved on top
# of the coach's gathering allowance; only a candidate that already failed spends
# one. Turn it down on an expensive tier; 0 = one attempt, then the fallback.
# LLM_VALIDATION_RETRIES=2
# Ordered coach-tier OpenRouter provider tags; empty leaves OpenRouter's routing alone.
# Fallbacks are always on, so this is a preference and never a way to fail a question.
# LLM_PROVIDER_ORDER=baidu/fp8,wafer/fast,coreweave/fp8
# LLM_PROVIDER_SORT=throughput

# ── Basemap + elevation caches (core/map_tiles.py, derive/dem.py) ───────
# Caches of PUBLIC geodata only. The defaults are the container's volume paths;
# on a dev box point them somewhere writable, e.g. .cache/ under this directory.
# SRTM_CACHE_DIR=/var/cache/healthee/srtm
# MAP_TILE_CACHE_DIR=/var/cache/healthee/tiles
# MAP_TILE_CACHE_MB=512

# ── Local embedding model cache (insights/embedding_index.py, Step 2a) ──────
# The QUERY-time ONNX model only (69 MB); the corpus passage matrix is a separate,
# committed artifact (packages/knowledge/embeddings/). Point this at somewhere
# writable, e.g. .cache/embeddings under this directory (tests do this for you).
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# EMBEDDING_CACHE_DIR=/var/cache/healthee/embeddings

# ── Coach evidence passage budget (insights/evidence.py, Step 2b) ──────────
# Whole-note evidence stays the default for every OTHER grounded surface — this
# trims only the coach's own block. Approx tokens = chars / 4.
# EVIDENCE_TOKEN_BUDGET=8000
# The cross-encoder rerank stage (same cache dir as the embedding model above).
# false skips it; a model that fails to load already degrades the same way.
# EVIDENCE_RERANK=false

# ── Basemap provider ────────────────────────────────────────────────────
# The app only ever asks THIS server for tiles; this server asks the provider.
# Repointing the template needs a matching attribution — GET /api/map serves
# both together, and the app draws no basemap when it cannot read them.
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors
# MAP_TILE_MIN_ZOOM=1
# MAP_TILE_MAX_ZOOM=17

# ── Telegram (optional — job status / failure alerts) ───────────────────
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
