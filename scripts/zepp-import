#!/usr/bin/env python3
"""Import workouts recorded in the Zepp app into a Healthee server.

    python3 scripts/zepp-import --dry-run
    python3 scripts/zepp-import

Standard library only: nothing to install. See scripts/zepp_import/README.md.
"""

import sys
from pathlib import Path

if sys.version_info < (3, 10):  # noqa: UP036 - the one guard that must run on an old Python
    sys.exit(
        "zepp-import needs Python 3.10 or newer and this is Python "
        + sys.version.split()[0]
        + ".\n  Termux on an Android phone has a newer one: pkg install python git"
    )

sys.path.insert(0, str(Path(__file__).resolve().parent))

from zepp_import.cli import main  # noqa: E402

sys.exit(main())
